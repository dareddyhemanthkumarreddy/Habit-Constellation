# Database connection string (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/habit_constellation?schema=public"

# JWT Secret for Auth Token Signatures
JWT_SECRET="habit_constellation_production_secret_key_change_me"

# Anthropic API Key (Claude) for Pattern Insights
# If left blank, warm non-clinical fallback insights will be returned
ANTHROPIC_API_KEY=""

# Server Port (Default: 5000)
PORT=5000
